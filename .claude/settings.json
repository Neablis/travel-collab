{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "statusMessage": "Installing dependencies..."
          },
          {
            "type": "command",
            "command": "node scripts/sync-launch-config.mjs 2>/dev/null || true",
            "statusMessage": "Syncing worktree launch config..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/check-destructive-git.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/resource-lease.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/draft-pr-guard.mjs",
            "if": "Bash(gh *)"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/orchestrator-lean-reads.mjs",
            "if": "Bash(gh *)"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/check-test-lane.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/commit-message-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/subagent-file-scope.mjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/orchestrator-no-code.mjs"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pr-tool-guard.mjs"
          }
        ]
      },
      {
        "matcher": "mcp__.*__get_job_logs",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/orchestrator-lean-reads.mjs"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/closed-agent-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/implementer-brief-check.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/typecheck-touched-package.mjs",
            "statusMessage": "Typechecking touched package..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/push-review-nudge.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/orchestrator-context-limit.mjs"
          }
        ]
      },
      {
        "matcher": "ReadNotifications",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/notification-unsubscribe-nudge.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/orchestrator-context-limit.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/subagent-report-conformance.mjs"
          }
        ]
      },
      {
        "matcher": "phase-implementer",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/implementer-report-check.mjs"
          }
        ]
      },
      {
        "matcher": "part-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/reviewer-report-check.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/run-teardown-reminder.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(./docs/**)",
      "Grep(./docs/**)",
      "Bash(pnpm surface:*)",
      "Bash(node scripts/surface-size.mjs:*)",
      "mcp__Vercel__list_toolbar_threads",
      "mcp__Vercel__get_toolbar_thread",
      "mcp__Vercel__reply_to_toolbar_thread",
      "mcp__Vercel__change_toolbar_thread_resolve_status",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__send_later"
    ]
  }
}
