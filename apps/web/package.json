{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p ${WEB_PORT:-3001}",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build-migrate.mjs && next build",
    "start": "next start -p ${WEB_PORT:-3001}",
    "lint": "eslint src e2e *.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.unit.config.ts",
    "test:int": "node scripts/with-test-db.mjs vitest run",
    "test:e2e": "NODE_OPTIONS=--import=./scripts/preload-dotenv.mjs node scripts/with-test-db.mjs --with-port playwright test",
    "test:e2e:ci-like": "pnpm build && CI=true pnpm test:e2e",
    "walk:preview": "node --env-file-if-exists=.env.local scripts/walk-preview.mjs",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-reset.mjs",
    "db:backfill-cities": "node --env-file-if-exists=.env.local scripts/backfill-saved-day-cities.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.ts",
    "db:reseed": "pnpm db:reset --yes && pnpm db:seed"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.68",
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.2",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.0",
    "@flags-sdk/vercel": "^1.4.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.72.0",
    "@sentry/profiling-node": "^10.72.0",
    "@tc/contracts": "workspace:*",
    "@tc/domain": "workspace:*",
    "@tc/fixtures": "workspace:*",
    "@tc/pages": "workspace:*",
    "@tc/predict": "workspace:*",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.84",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "flags": "^4.3.0",
    "lucide-react": "^1.37.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tc/factories": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.24",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
