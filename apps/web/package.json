{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --turbopack -p ${WEB_PORT:-3001}",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "vercel-build": "node scripts/vercel-build-migrate.mjs && node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start -p ${WEB_PORT:-3001}",
    "lint": "eslint --max-warnings 0 src e2e *.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.unit.config.ts",
    "test:int": "node scripts/with-test-db.mjs vitest run",
    "eval": "node scripts/with-test-db.mjs pnpm run eval:run",
    "eval:run": "vitest run -c vitest.eval.config.ts",
    "test:e2e": "NODE_OPTIONS=--import=./scripts/preload-dotenv.mjs node scripts/with-test-db.mjs --with-port playwright test",
    "test:e2e:ci-like": "NEXT_PUBLIC_SENTRY_DSN='' pnpm build && pnpm check:build-sentry && CI=true pnpm test:e2e",
    "check:build-sentry": "node scripts/check-build-has-no-sentry-dsn.mjs",
    "walk:preview": "node --env-file-if-exists=.env.local scripts/walk-preview.mjs",
    "live-set": "node --env-file-if-exists=.env.local scripts/assistant-live-set.mjs",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs check",
    "db:state": "node --env-file-if-exists=.env.local scripts/check-migration-state.mjs",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-reset.mjs",
    "db:backfill-cities": "node --env-file-if-exists=.env.local scripts/backfill-saved-day-cities.mjs",
    "db:backfill-countries": "node --env-file-if-exists=.env.local scripts/backfill-saved-day-countries.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.ts",
    "db:reseed": "pnpm db:reset --yes && pnpm db:seed && pnpm content:import",
    "content:import": "node --env-file-if-exists=.env.local scripts/import-content.ts",
    "content:verify": "node scripts/import-content.ts --dry-run",
    "landing:generate": "node --import ./scripts/lib/ts-resolve-register.mjs scripts/landing-demo.ts",
    "landing:verify": "node --import ./scripts/lib/ts-resolve-register.mjs scripts/landing-demo.ts --check",
    "og:tokens": "node scripts/generate-og-tokens.mjs",
    "og:verify": "node scripts/generate-og-tokens.mjs --check",
    "openapi:generate": "UPDATE_OPENAPI=1 vitest run -c vitest.unit.config.ts src/server/public-api/openapi.test.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.100",
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.0",
    "@flags-sdk/vercel": "^1.4.10",
    "@photostructure/tz-lookup": "^11.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@scalar/api-reference-react": "^0.9.76",
    "@sentry/nextjs": "^10.75.3",
    "@sentry/profiling-node": "^10.75.3",
    "@tc/contracts": "workspace:*",
    "@tc/domain": "workspace:*",
    "@tc/fixtures": "workspace:*",
    "@tc/pages": "workspace:*",
    "@tc/predict": "workspace:*",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.9.9",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.122",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "flags": "^4.3.1",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tc/factories": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.26",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "zod-to-json-schema": "^3.25.2"
  }
}
