{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3001}",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build-migrate.mjs && next build",
    "start": "next start -p ${WEB_PORT:-3001}",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.unit.config.ts",
    "test:int": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/db-reset.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.0.0",
    "@tc/contracts": "workspace:*",
    "@tc/domain": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.36.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.7",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
