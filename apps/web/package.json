{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p ${WEB_PORT:-3001}",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build-migrate.mjs && next build",
    "start": "next start -p ${WEB_PORT:-3001}",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.unit.config.ts",
    "test:int": "vitest run",
    "test:e2e": "NODE_OPTIONS=--import=./scripts/preload-dotenv.mjs playwright test",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-reset.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.mjs",
    "db:reseed": "pnpm db:reset --yes && pnpm db:seed"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.26",
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.0.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tc/contracts": "workspace:*",
    "@tc/domain": "workspace:*",
    "@tc/pages": "workspace:*",
    "@tc/predict": "workspace:*",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@tiptap/suggestion": "^2.11.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.0",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tippy.js": "6.3.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
