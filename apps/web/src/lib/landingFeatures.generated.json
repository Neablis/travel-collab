        "00000000-0000-4000-80c0-000000000017": {
          "activityId": "00000000-0000-4000-80c0-000000000017",
          "title": "Citron tasting at the Vallindras distillery, Halki",
          "timeWindow": {
            "start": "14:45",
            "end": "15:30"
          },
          "location": {
            "name": "Vallindras Distillery",
            "lat": 37.063013,
            "lng": 25.482285,
            "countryCode": "GR",
            "city": "Halki",
            "area": "Halki village"
          },
          "notes": "Fifteen minutes, free, and still using the copper stills from 1896. Three strengths of kitron: green is the sweet one people like on the day, yellow is the one worth carrying home. Skip it if you are driving the mountain road afterwards.",
