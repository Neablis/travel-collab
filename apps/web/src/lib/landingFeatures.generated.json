        },
        "00000000-0000-4000-80c0-000000000015": {
          "activityId": "00000000-0000-4000-80c0-000000000015",
          "title": "Down the Agia Marina side to close the loop",
          "timeWindow": {
            "start": "11:05",
            "end": "12:30"
          },
          "location": {
            "name": "Agia Marina chapel",
            "lat": 37.044701,
            "lng": 25.507188,
            "countryCode": "GR",
            "city": "Filoti",
            "area": "Agia Marina"
          },
          "notes": "Retracing your steps is faster; the loop down past the Agia Marina chapel and back along the contour to Filoti is the better half of the walk and costs about 40 extra minutes. Roughly 12.8 km all in.",
          "anchors": [],
