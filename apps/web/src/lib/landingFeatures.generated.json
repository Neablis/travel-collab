        "00000000-0000-4000-80c0-000000000016": {
          "activityId": "00000000-0000-4000-80c0-000000000016",
          "title": "Lunch at Lefteris in Apeiranthos",
          "timeWindow": {
            "start": "13:00",
            "end": "14:30"
          },
          "location": {
            "name": "Lefteris",
            "lat": 37.071792,
            "lng": 25.519616,
            "countryCode": "GR",
            "city": "Apeiranthos",
            "area": "Marble village",
            "precision": "city"
          },
          "notes": "Apeiranthos is entirely paved in marble and has five small museums nobody visits. Ask for the goat in lemon and take the back terrace — it looks straight down the valley you spent the morning walking out of, which is the only way to make sense of the shape of the island.",
