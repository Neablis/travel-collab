        "00000000-0000-4000-80c0-000000000014": {
          "activityId": "00000000-0000-4000-80c0-000000000014",
          "title": "Zas Cave and the push to 1,003 m",
          "timeWindow": {
            "start": "08:10",
            "end": "11:00"
          },
          "location": {
            "name": "Mount Zas summit",
            "countryCode": "GR",
            "city": "Filoti",
            "area": "Mount Zas"
          },
          "notes": "The cave where Zeus was supposedly hidden is twenty minutes above the spring and worth the detour; take a torch, it goes back further than it looks. From there the route is cairns rather than signs and the last half hour is loose scree — if the cloud is down on the summit the cairns are genuinely hard to follow, so turn round rather than guess.",
          "anchors": [],
          "kind": "planned",
