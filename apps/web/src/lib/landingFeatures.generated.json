        "00000000-0000-4000-80c0-000000000013": {
          "activityId": "00000000-0000-4000-80c0-000000000013",
          "title": "Fill both bottles at the Aria Spring",
          "timeWindow": {
            "start": "07:35",
            "end": "08:05"
          },
          "location": {
            "name": "Aria Spring",
            "countryCode": "GR",
            "city": "Filoti",
            "area": "Aria"
          },
          "notes": "A stone well under a plane tree, running cold straight out of the mountain and safe to drink. It is the last water on the route in both directions — two litres each, and it is also the best-placed drink on the whole descent.",
          "anchors": [],
